# Root .htaccess for Mellow & Meadow Café Website
# Platform: Apache / Shared Hosting (cPanel)

# 1. Disable directory browsing
Options -Indexes

# 2. Prevent direct access to config and includes directories
RewriteEngine On
RewriteRule ^(config|includes|database)/.*$ - [F,L]

# 3. Protect sensitive files
<FilesMatch "^\.env|composer\.json|composer\.lock|README\.md|CLIENT_GUIDE\.md|PRODUCTION_CHECKLIST\.md|config\.example\.php|cafe_database\.sql$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 4. Gzip Compression for Page Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 5. Leverage Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
