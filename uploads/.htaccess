# Disable PHP execution in uploads folder for security
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Force download or just serve as simple binary/text if it matches other executable types
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py
